{
  "schema_version": 1,
  "catalog": "wosb-master-data",
  "documents": [
    {
      "path": "builds/categories.json",
      "kind": "build_categories"
    },
    {
      "path": "builds/options/*/*.json",
      "kind": "build_options"
    },
    {
      "path": "system/build-rules.json",
      "kind": "build_rules"
    },
    {
      "path": "system/fleets.json",
      "kind": "fleets"
    },
    {
      "path": "system/roles.json",
      "kind": "roles"
    },
    {
      "path": "references.json",
      "kind": "references"
    },
    {
      "path": "ships/definitions.json",
      "kind": "ship_definitions"
    },
    {
      "path": "ships/rates/*/*.json",
      "kind": "ships"
    }
  ]
}
