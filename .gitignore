# Python caches, environments, build and test output
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
site/
.venv/
.venv-*/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/

# Node/Vite caches and generated output
node_modules/
.vite/
.npm/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/src/locales/generated/

# Environment files and local runtime data
.env
.env.*
!.env.example
!.env.*.example
*.local
*.db
*.sqlite
*.sqlite3
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~
infrastructure/data/
infrastructure/first-run-credentials.txt

# Credentials, private keys and local trust stores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.agekey
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
