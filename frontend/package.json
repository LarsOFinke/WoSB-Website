{
  "name": "royal-blackwater-fleet-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1",
    "dev:default": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:locales": "node scripts/check-locales.mjs",
    "test:build-designer": "node scripts/test-build-designer-inventory.mjs",
    "locales:generate": "node scripts/generate-locales.mjs",
    "predev": "node scripts/check-env.mjs && npm run locales:generate",
    "prebuild": "node scripts/check-env.mjs && npm run locales:generate",
    "prepreview": "node scripts/check-env.mjs",
    "pretest": "npm run locales:generate",
    "test": "npm run test:unit && npm run test:build-designer && npm run check:page-bindings && npm run check:locales",
    "test:ci": "npm run test && npm run build",
    "test:unit": "node --test tests/*.test.mjs",
    "check:page-bindings": "node scripts/check-page-bindings.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "markdown-it": "^14.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.39",
    "vite": "^8.1.3"
  }
}
