# Host-runner source configuration for the standalone Discord bot.
# These values belong to /etc/rbf-hub/discord-bot-manager.env on the WEBSITE host.
# They are not bot runtime variables and must not be added to bot.env.
# Example: git@github.com:your-organisation/royal-blackwater-discord-bot.git
RBF_DISCORD_BOT_REPO_URL=
RBF_DISCORD_BOT_BRANCH=main
RBF_DISCORD_BOT_INSTALL_DIR=/opt/rbf-discord-bot

# Optional but recommended for private SSH repositories.
# The root-owned manager uses this exact private key instead of relying on
# /root/.ssh/config, an interactive ssh-agent or the login user's HOME.
# Use an unencrypted read-only deploy key dedicated to the bot repository.
RBF_DISCORD_BOT_GIT_SSH_KEY_FILE=

# Must contain the repository host key. Example for GitHub:
#   sudo install -d -m 0700 /root/.ssh
#   sudo ssh-keyscan -H github.com | sudo tee /root/.ssh/rbf-discord-known_hosts >/dev/null
RBF_DISCORD_BOT_GIT_KNOWN_HOSTS_FILE=/root/.ssh/rbf-discord-known_hosts
RBF_DISCORD_BOT_GIT_SSH_PORT=22
