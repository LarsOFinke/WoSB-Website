# Host-runner source configuration for the standalone Discord bot.
# These values belong to /etc/rbf-hub/discord-bot-manager.env on the WEBSITE host.
# They are not bot runtime variables and must not be added to bot.env.
# Example: git@github.com:your-organisation/royal-blackwater-discord-bot.git
RBF_DISCORD_BOT_REPO_URL=
RBF_DISCORD_BOT_BRANCH=main
RBF_DISCORD_BOT_INSTALL_DIR=/opt/rbf-discord-bot
