[Unit]
Description=Royal Blackwater Fleet container stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@INFRA_DIR@
ExecStart=/usr/bin/env bash @INFRA_DIR@/scripts/services/boot.sh
ExecStop=/usr/bin/env bash @INFRA_DIR@/scripts/services/systemd-stop.sh
# Includes PostgreSQL initialization, the isolated Flyway boundary and the
# bounded Spring readiness loop. Keep this above all nested startup budgets.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
