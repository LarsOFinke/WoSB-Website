# Generated and maintained by infrastructure/setup.sh.
COMPOSE_PROJECT_NAME=rbf-hub
APP_HOSTNAME=royal-blackwater-fleet.eu
APP_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TLS_MODE=auto
CERTIFICATE_PROVIDER=self-signed
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false
LETSENCRYPT_CERT_NAME=royal-blackwater-fleet.eu
ENABLE_MONITORING=true
UPTIME_KUMA_LOCAL_PORT=3001
MONITORING_HTTPS_PORT=8443
POSTGRES_LOCAL_PORT=15432
BACKUP_RETENTION_DAYS=14
# Optional absolute path to an encrypted/mounted external backup target.
BACKUP_OFFSITE_DIR=

POSTGRES_USER=rbf
POSTGRES_DB=rbf
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP

APP_ENV=production
DATABASE_URL=postgresql+psycopg://rbf:CHANGE_ME_GENERATED_BY_SETUP@postgres:5432/rbf
DB_SCHEMA_MODE=migrate
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=https://royal-blackwater-fleet.eu,https://127.0.0.1
SESSION_COOKIE_SECURE=true
AUTO_SEED=false

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP
SEED_ADMIN_DISPLAY_NAME="RBF Command"

# Host control exchange: API writes only inbox requests and reads root-owned status.
CONTROL_REQUEST_DIR=/run/rbf-control/inbox
CONTROL_STATUS_DIR=/run/rbf-control/status
