# Generated and maintained by infrastructure/setup.sh.
COMPOSE_PROJECT_NAME=rbf-hub
APP_HOSTNAME=royal-blackwater-fleet.eu
APP_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TLS_MODE=auto
CERTIFICATE_PROVIDER=self-signed
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false
LETSENCRYPT_CERT_NAME=royal-blackwater-fleet.eu
ENABLE_MONITORING=true
UPTIME_KUMA_LOCAL_PORT=3001
MONITORING_HTTPS_PORT=8443
POSTGRES_LOCAL_PORT=15432
BACKUP_RETENTION_DAYS=14
# A productive backup set is committed only after the API is quiesced (or was not running).
BACKUP_QUIESCE_APPLICATION=true
# Doctor fails if the latest committed backup set is older than this threshold.
BACKUP_MAX_AGE_HOURS=36
# Fail-closed plausibility floors; tune only for deliberately tiny test installations.
BACKUP_MIN_POSTGRES_BYTES=1024
BACKUP_MIN_FILES_BYTES=64
BACKUP_MIN_RECOVERY_BYTES=1024
# Complete age-encrypted disaster-recovery bundle (database, files, .env, .cfg and host secrets).
BACKUP_RECOVERY_ENABLED=false
# Public age recipient generated and retained on the external backup device. Never store the private key here.
BACKUP_AGE_RECIPIENT=
# Optional root-owned offsite mount for all backup artifacts.
BACKUP_OFFSITE_DIR=
# Optional pull-export for encrypted recovery bundles, e.g. /home/admin/rbf-backups and admin.
BACKUP_PULL_EXPORT_DIR=
BACKUP_PULL_EXPORT_USER=

POSTGRES_USER=rbf
POSTGRES_DB=rbf
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP

APP_ENV=production
DATABASE_URL=postgresql+psycopg://rbf:CHANGE_ME_GENERATED_BY_SETUP@postgres:5432/rbf
DB_SCHEMA_MODE=migrate
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=https://royal-blackwater-fleet.eu,https://127.0.0.1
SESSION_COOKIE_SECURE=true
AUTO_SEED=false

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP
WEBHOOK_ENCRYPTION_KEYS=CHANGE_ME_GENERATED_BY_SETUP
SEED_ADMIN_DISPLAY_NAME="RBF Command"

# Host control exchange: API writes only inbox requests and reads root-owned status.
CONTROL_REQUEST_DIR=/run/rbf-control/inbox
CONTROL_STATUS_DIR=/run/rbf-control/status

# Public legal-notice defaults. Administrator edits are stored in PostgreSQL.
LEGAL_NOTICE_PUBLISHED=false
LEGAL_NOTICE_PROVIDER_NAME=
LEGAL_NOTICE_LEGAL_FORM=
LEGAL_NOTICE_REPRESENTED_BY=
LEGAL_NOTICE_STREET=
LEGAL_NOTICE_POSTAL_CODE=
LEGAL_NOTICE_CITY=
LEGAL_NOTICE_COUNTRY=Deutschland
LEGAL_NOTICE_EMAIL=
LEGAL_NOTICE_PHONE=
LEGAL_NOTICE_REGISTER_NAME=
LEGAL_NOTICE_REGISTER_COURT=
LEGAL_NOTICE_REGISTER_NUMBER=
LEGAL_NOTICE_VAT_ID=
LEGAL_NOTICE_BUSINESS_ID=
LEGAL_NOTICE_SUPERVISORY_AUTHORITY=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_NAME=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_STREET=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_POSTAL_CODE=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_CITY=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_COUNTRY=Deutschland
LEGAL_NOTICE_DISPUTE_RESOLUTION_TEXT=
LEGAL_NOTICE_ADDITIONAL_INFORMATION=
