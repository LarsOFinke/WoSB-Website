# Generated and maintained by infrastructure/setup.sh.
COMPOSE_PROJECT_NAME=rbf-hub
APP_HOSTNAME=royal-blackwater-fleet.eu
APP_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TLS_MODE=auto
CERTIFICATE_PROVIDER=self-signed
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false
LETSENCRYPT_CERT_NAME=royal-blackwater-fleet.eu
POSTGRES_LOCAL_PORT=15432
GATEWAY_MAX_BODY_MB=90

POSTGRES_USER=rbf
POSTGRES_DB=rbf
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP
RBF_API_IMAGE=rbf-hub-api:local
RBF_GATEWAY_IMAGE=rbf-hub-gateway:local

APP_ENV=production
# Keep successful-request telemetry off in normal operation; test automation enables it explicitly.
RBF_HTTP_LIFECYCLE_LOGGING=false
FLYWAY_BASELINE_ON_MIGRATE=false
DB_POOL_MAX_SIZE=12
DB_POOL_MIN_IDLE=1
UPLOAD_DIR=/var/lib/rbf/uploads
CORS_ORIGINS=https://royal-blackwater-fleet.eu,https://127.0.0.1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=rbf_hub_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=24
COOKIE_CONSENT_RETENTION=400d
RESOLVED_PRIVACY_REQUEST_RETENTION=400d
PRIVACY_RETENTION_INTERVAL=PT24H

# Required only until the first bootstrap administrator is created.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP
SEED_ADMIN_DISPLAY_NAME=RBF Command
# One or more comma-separated Fernet keys; the first key encrypts new secrets.
WEBHOOK_ENCRYPTION_KEYS=CHANGE_ME_GENERATED_BY_SETUP

CONTROL_DIR=/var/lib/rbf/control
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=52MB
UPLOAD_IMAGE_LIMIT_MB=12
UPLOAD_DOCUMENT_LIMIT_MB=24
UPLOAD_VIDEO_LIMIT_MB=50
UPLOAD_PER_USER_TOTAL_MB=250
UPLOAD_GLOBAL_TOTAL_MB=4096
UPLOAD_MINIMUM_FREE_MB=512

BACKUP_RETENTION_DAYS=14
BACKUP_QUIESCE_APPLICATION=true
BACKUP_MAX_AGE_HOURS=36
BACKUP_MIN_POSTGRES_BYTES=1024
BACKUP_MIN_FILES_BYTES=64
BACKUP_OFFSITE_DIR=
BACKUP_AGE_RECIPIENT=

LEGAL_NOTICE_PUBLISHED=false
LEGAL_NOTICE_PROVIDER_NAME=
LEGAL_NOTICE_LEGAL_FORM=
LEGAL_NOTICE_REPRESENTED_BY=
LEGAL_NOTICE_STREET=
LEGAL_NOTICE_POSTAL_CODE=
LEGAL_NOTICE_CITY=
LEGAL_NOTICE_COUNTRY=Deutschland
LEGAL_NOTICE_EMAIL=
LEGAL_NOTICE_PHONE=
LEGAL_NOTICE_REGISTER_NAME=
LEGAL_NOTICE_REGISTER_COURT=
LEGAL_NOTICE_REGISTER_NUMBER=
LEGAL_NOTICE_VAT_ID=
LEGAL_NOTICE_BUSINESS_ID=
LEGAL_NOTICE_SUPERVISORY_AUTHORITY=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_NAME=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_STREET=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_POSTAL_CODE=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_CITY=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_COUNTRY=Deutschland
LEGAL_NOTICE_DISPUTE_RESOLUTION_TEXT=
LEGAL_NOTICE_ADDITIONAL_INFORMATION=
