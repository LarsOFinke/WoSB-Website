# Local development configuration.
# Copy this file to backend/.env and change the seeded admin password.

APP_ENV=development
DATABASE_URL=sqlite:///./storage/blackwater-hub.db
UPLOAD_DIR=storage/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
AUTO_SEED=true

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
SEED_ADMIN_DISPLAY_NAME=Community Admin
