# Production example (PostgreSQL + Alembic).
# In the Pi deployment these values are generated in infrastructure/.env.

APP_ENV=production
DATABASE_URL=postgresql+psycopg://rbf:CHANGE_ME@postgres:5432/rbf
DB_SCHEMA_MODE=migrate
UPLOAD_DIR=/data/uploads
CONTROL_REQUEST_DIR=/run/rbf-control/inbox
CONTROL_STATUS_DIR=/run/rbf-control/status
CORS_ORIGINS=https://royal-blackwater-fleet.eu
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=rbf_hub_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=24
AUTO_SEED=false

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
SEED_ADMIN_DISPLAY_NAME=RBF Command

# Optional comma-separated Fernet keys. The first key encrypts new Discord
# webhook credentials; older keys remain available for rotation/decryption.
# Generate one with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
# WEBHOOK_ENCRYPTION_KEYS=

# Optional: override the default /app/config directory.
# RBF_CONFIG_DIR=/app/config

# Legal-notice defaults. Keep unpublished until the complete provider details
# have been reviewed. Staff Panel changes are persisted in the database.
LEGAL_NOTICE_PUBLISHED=false
LEGAL_NOTICE_PROVIDER_NAME=
LEGAL_NOTICE_LEGAL_FORM=
LEGAL_NOTICE_REPRESENTED_BY=
LEGAL_NOTICE_STREET=
LEGAL_NOTICE_POSTAL_CODE=
LEGAL_NOTICE_CITY=
LEGAL_NOTICE_COUNTRY=Deutschland
LEGAL_NOTICE_EMAIL=
LEGAL_NOTICE_PHONE=
LEGAL_NOTICE_REGISTER_NAME=
LEGAL_NOTICE_REGISTER_COURT=
LEGAL_NOTICE_REGISTER_NUMBER=
LEGAL_NOTICE_VAT_ID=
LEGAL_NOTICE_BUSINESS_ID=
LEGAL_NOTICE_SUPERVISORY_AUTHORITY=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_NAME=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_STREET=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_POSTAL_CODE=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_CITY=
LEGAL_NOTICE_EDITORIAL_RESPONSIBLE_COUNTRY=Deutschland
LEGAL_NOTICE_DISPUTE_RESOLUTION_TEXT=
LEGAL_NOTICE_ADDITIONAL_INFORMATION=
