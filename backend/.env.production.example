# Production example (PostgreSQL + Alembic).
# In the Pi deployment these values are generated in infrastructure/.env.

APP_ENV=production
DATABASE_URL=postgresql+psycopg://rbv:CHANGE_ME@postgres:5432/rbv
DB_SCHEMA_MODE=migrate
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=https://royal-blackwater-vanguards.eu
SESSION_COOKIE_SECURE=true
AUTO_SEED=true

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
SEED_ADMIN_DISPLAY_NAME=RBV Command
