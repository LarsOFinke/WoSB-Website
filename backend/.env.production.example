# Production example (PostgreSQL + Alembic).
# In the Pi deployment these values are generated in infrastructure/.env.

APP_ENV=production
DATABASE_URL=postgresql+psycopg://blackwater:CHANGE_ME@postgres:5432/blackwater
DB_SCHEMA_MODE=migrate
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=https://your-domain.example
SESSION_COOKIE_SECURE=true
AUTO_SEED=true

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
SEED_ADMIN_DISPLAY_NAME=Blackwater Command
