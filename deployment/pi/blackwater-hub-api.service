[Unit]
Description=Blackwater Mercenaries Hub API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/blackwater-mercenaries-hub/app/backend
Environment=WOSB_ENV_FILE=/opt/blackwater-mercenaries-hub/app/backend/.env
Environment=WOSB_CONFIG_FILE=/opt/blackwater-mercenaries-hub/app/backend/config/app.toml
ExecStart=/opt/blackwater-mercenaries-hub/app/backend/.venv/bin/uvicorn main:app --app-dir src --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/blackwater-mercenaries-hub/data /opt/blackwater-mercenaries-hub/uploads /opt/blackwater-mercenaries-hub/app/backend

[Install]
WantedBy=multi-user.target
