# Origin-to-website deployment configuration for the test server.
# Copy to .env.origin.test and keep it private (chmod 600).
RBF_DEPLOY_HOST=test-web.example.org
RBF_DEPLOY_USER=rbfadmin
RBF_DEPLOY_PORT=22
RBF_DEPLOY_REMOTE_DIR=/tmp/rbf-release
# Optional external credential path. Auto-detected first as
# $HOME/.ssh/rbf-deploy-test-rbfadmin, then the legacy $HOME/.ssh/rbfadmin.
# Relative names resolve below $HOME/.ssh; repository paths are rejected.
RBF_DEPLOY_IDENTITY_FILE=
# Rotate the dedicated deployment key on every release after replacement access verifies.
RBF_DEPLOY_ROTATE_SSH_KEY=true
RBF_DEPLOY_INSTALL_ROOT=/srv/rbf
# Path as seen on the selected website server; never copy server secrets into this repository.
RBF_DEPLOY_ENV_SOURCE=/secure/rbf.env
