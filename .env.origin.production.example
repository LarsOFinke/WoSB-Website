# Origin-to-website deployment configuration for the production server.
# Copy to .env.origin.production and keep it private (chmod 600).
RBF_DEPLOY_HOST=web.example.org
RBF_DEPLOY_USER=rbfadmin
RBF_DEPLOY_PORT=22
RBF_DEPLOY_REMOTE_DIR=/tmp/rbf-release
# Optional: auto-detected as $HOME/.ssh/rbfadmin when this is empty.
RBF_DEPLOY_IDENTITY_FILE=
RBF_DEPLOY_INSTALL_ROOT=/srv/rbf
# Path as seen on the selected website server; never copy server secrets into this repository.
RBF_DEPLOY_ENV_SOURCE=/secure/rbf.env
